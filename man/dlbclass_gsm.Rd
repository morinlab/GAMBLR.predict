            setdiff(feature_order[!grepl("^X|^SV[.]", feature_order)],
                    c("MYD88.L265P", "MYD88.OTHER")))
maf = get_ssm_by_regions(
  regions_list = GAMBLR.utils::gene_to_region(gene_symbol = genes,
                                              projection = "grch37",
                                              return_as = "region"),
  these_samples_metadata = meta)

